{
  "name": "mobile-appium-automation",
  "version": "1.0.0",
  "description": "Appium + WebdriverIO mobile automation framework for Android demo app",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "download:app": "bash scripts/download-app.sh",
    "appium:doctor": "npx appium driver doctor uiautomator2",
    "appium:server": "npx appium --address 127.0.0.1 --port 4723",
    "emu:list": "bash scripts/list-emulators.sh",
    "emu:start": "bash scripts/start-emulator.sh",
    "install:apk": "bash scripts/install-apk.sh",
    "test": "wdio run wdio.conf.js",
    "test:login": "wdio run wdio.conf.js --spec ./test/specs/login.spec.js",
    "test:catalog": "wdio run wdio.conf.js --spec ./test/specs/catalog.spec.js",
    "test:cart": "wdio run wdio.conf.js --spec ./test/specs/cart.spec.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "android",
    "mobile",
    "automation",
    "allure"
  ],
  "author": "pervalashiva",
  "license": "ISC",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/appium-service": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.0",
    "expect-webdriverio": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
